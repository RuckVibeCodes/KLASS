# ===========================================
# Clerk Authentication
# ===========================================
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk URLs (customize if needed)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ===========================================
# Supabase Database
# ===========================================
# Get these from https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ===========================================
# Stripe Payments
# ===========================================
# Get these from https://dashboard.stripe.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...

# Platform subscription price IDs (KLASS plans for community creators)
STRIPE_PRICE_PLATFORM_DIY=price_...
STRIPE_PRICE_PLATFORM_DWY=price_...
STRIPE_PRICE_PLATFORM_DFY=price_...

# Stripe Connect (separate webhook secret for Connect events)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# ===========================================
# Whop Integration (Optional)
# ===========================================
# Get these from https://dash.whop.com
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=

# ===========================================
# Resend Email (Lead Nurturing)
# ===========================================
# Get your API key from https://resend.com
RESEND_API_KEY=re_...

# Webhook secret for Resend events (optional)
RESEND_WEBHOOK_SECRET=

# Cron secret for scheduled jobs
CRON_SECRET=your-cron-secret-here

# ===========================================
# App Configuration
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
